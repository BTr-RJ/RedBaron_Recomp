<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RedBaron_Recomp" Width="1060" Height="820" MinWidth="920" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#15191F" Foreground="#F1F3F7"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" Language="en-US">
  <Window.Resources>
    <SolidColorBrush x:Key="InputBackground" Color="#252C36"/>
    <SolidColorBrush x:Key="InputBorder" Color="#455161"/>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#AEB9CA"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="22"/></Style>
    <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#2A333F"/><Setter Property="Foreground" Value="#F1F3F7"/>
      <Setter Property="BorderBrush" Value="#455161"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,9"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#B7C3D5"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#F1F3F7"/><Setter TargetName="Border" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Opacity" Value="0.75"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#BA343D"/><Setter Property="BorderBrush" Value="#BA343D"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource InputBackground}"/><Setter Property="Foreground" Value="#F1F3F7"/>
      <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/><Setter Property="CaretBrush" Value="#FFFFFF"/>
      <Setter Property="SelectionBrush" Value="#99404A"/><Setter Property="Padding" Value="10,8"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#E28B90"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#252C36"/><Setter Property="Foreground" Value="#F1F3F7"/><Setter Property="Padding" Value="10,8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Item" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#3D4859"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#51303A"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#919BAC"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{StaticResource InputBackground}"/><Setter Property="Foreground" Value="#F1F3F7"/>
      <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/><Setter Property="MinHeight" Value="38"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border Background="#252C36" BorderBrush="#455161" BorderThickness="1" CornerRadius="3"><Grid><Path Data="M 0 0 L 4 4 L 8 0" Stroke="#C8D1DF" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Grid></Border>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Margin="12,7,32,7" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
            <Border Background="#252C36" BorderBrush="#718096" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="340">
              <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E1E6EE"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#B9C3D2"/><Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="24,14"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="Tab" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}">
          <ContentPresenter ContentSource="Header"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/><Setter TargetName="Tab" Property="BorderBrush" Value="#E0646D"/><Setter TargetName="Tab" Property="Background" Value="#242830"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#202731"/><Setter Property="Foreground" Value="#BFC9D9"/><Setter Property="Padding" Value="10,10"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#3C4757"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,2"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#F1F3F7"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#3A3340"/></Trigger></Style.Triggers></Style>
    <Style TargetType="DataGridRow"><Setter Property="Background" Value="#1B212A"/><Setter Property="MinHeight" Value="42"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#302D39"/></Trigger></Style.Triggers></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#1C2028" BorderBrush="#323A47" BorderThickness="0,0,0,1" Padding="28,0">
      <Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="RedBaron_Recomp" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Snoopy Flying Ace · PC" Foreground="#ACB7C8" FontSize="12" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Name="UpdateBadge" Text="Update available" Visibility="Collapsed" VerticalAlignment="Center" Foreground="#F1C477" Margin="0,0,18,0"/>
          <TextBlock Name="HeaderStatus" Text="Checking installation…" VerticalAlignment="Center" Foreground="#B7C6BC" Margin="0,0,18,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <TabControl Name="Tabs" Grid.Row="1" Background="#15191F" BorderThickness="0" Foreground="#F1F3F7" Padding="28,24,28,12">
      <TabItem Header="Install">
        <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="Install the game" Style="{StaticResource Heading}"/>
          <TextBlock Text="Choose your game source and an installation folder. Add a DLC folder to install both together, or leave it empty to install only the game." Style="{StaticResource Muted}" Margin="0,0,0,24"/>
          <TextBlock Text="Game files" Margin="0,0,0,7"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBox Name="SourcePath" AutomationProperties.Name="Game folder, default.xex or STFS package"/><Button Name="BrowseSource" Content="Folder…" Grid.Column="1" Margin="10,0,0,0"/><Button Name="BrowseSourceFile" Content="File…" Grid.Column="2" Margin="10,0,0,0"/></Grid>
          <TextBlock Text="Select an extracted game folder, default.xex, or the original Xbox 360 STFS package. The package can have no file extension." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,20"/>
          <TextBlock Text="DLC files (optional)" Margin="0,0,0,7"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBox Name="DlcSource" AutomationProperties.Name="Optional DLC folder"/><Button Name="BrowseDlc" Content="Browse…" Grid.Column="1" Margin="10,0,0,0"/></Grid>
          <TextBlock Text="If the game is already installed, the same Install button adds only the DLCs. Existing game files and saves are preserved." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,20"/>
          <TextBlock Text="Installation folder" Margin="0,0,0,7"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBox Name="DestinationPath" AutomationProperties.Name="Destination folder"/><Button Name="BrowseDestination" Content="Browse…" Grid.Column="1" Margin="10,0,0,0"/></Grid>
          <CheckBox Name="DesktopShortcut" Content="Create a desktop shortcut" Margin="0,16,0,20"/>
          <Expander Name="BuildToolsPanel" Foreground="#D5DDE9" Header="Build tools — checking…" IsExpanded="False">
            <StackPanel Margin="0,12,0,0"><TextBlock Name="ToolInventory" Text="Checking installed tools…" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
              <Button Name="CheckTools" Content="Check installed tools" HorizontalAlignment="Left" Margin="0,0,0,16"/>
              <TextBlock Text="ReXGlue SDK folder (used if no SDK is bundled)" Margin="0,0,0,7"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBox Name="SdkPath" AutomationProperties.Name="SDK folder"/><Button Name="BrowseSdk" Content="Browse…" Grid.Column="1" Margin="10,0,0,0"/></Grid>
              <TextBlock Name="SdkInfo" Text="Checking build tools…" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,14"/>
            </StackPanel>
          </Expander>
          <ProgressBar Name="InstallProgress" Height="5" Background="#2C3440" Foreground="#D65F68" IsIndeterminate="True" Visibility="Collapsed"/>
          <TextBlock Name="InstallState" Style="{StaticResource Muted}" Margin="0,10,0,8"/>
          <TextBox Name="InstallLog" IsReadOnly="True" Height="120" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12" Visibility="Collapsed"/>
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0"><Button Name="InstallButton" Content="Install" Style="{StaticResource Primary}"/><Button Name="CancelInstall" Content="Cancel installation" Margin="10,0,0,0" Visibility="Collapsed"/><Button Name="UseExisting" Content="Use existing installation…" Margin="10,0,0,0"/></StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Video">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="Graphics and performance" Style="{StaticResource Heading}"/>
          <TextBlock Name="GpuSummary" Text="Detecting GPUs and available settings…" Style="{StaticResource Muted}" Margin="0,0,0,24"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="GPU" Margin="0,0,0,7"/><ComboBox Name="Gpu" AutomationProperties.Name="GPU"/><TextBlock Text="Window resolution" Margin="0,20,0,7"/><ComboBox Name="Resolution" AutomationProperties.Name="Resolution"/><TextBlock Text="Display mode" Margin="0,20,0,7"/><ComboBox Name="DisplayMode" AutomationProperties.Name="Display mode"/><TextBlock Text="Fullscreen uses the desktop resolution. The game keeps its 16:9 aspect ratio." Style="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/><TextBlock Text="Internal render resolution" Margin="0,20,0,7"/><ComboBox Name="RenderScale" AutomationProperties.Name="Internal render resolution"/><TextBlock Text="Higher scales improve 3D detail and use more GPU memory. Start at 1× or 2×." Style="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/><CheckBox Name="Vsync" Content="VSync · synchronize with the monitor" Margin="0,22,0,0"/><CheckBox Name="Hdr" Content="Use HDR output when available" Margin="0,16,0,0"/><TextBlock Name="HdrInfo" Style="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Anisotropic filtering" Margin="0,0,0,7"/><ComboBox Name="Anisotropic" AutomationProperties.Name="Anisotropic filtering"/><TextBlock Text="Antialiasing" Margin="0,20,0,7"/><ComboBox Name="Antialiasing" AutomationProperties.Name="Antialiasing"/><TextBlock Text="Upscaling" Margin="0,20,0,7"/><ComboBox Name="Upscaling" AutomationProperties.Name="Upscaling"/><TextBlock Text="DLSS mode" Margin="0,20,0,7"/><ComboBox Name="DlssMode" AutomationProperties.Name="DLSS mode"/><TextBlock Name="DlssInfo" Style="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/><TextBlock Text="FSR sharpness" Margin="0,20,0,7"/><ComboBox Name="FsrSharpness" AutomationProperties.Name="FSR sharpness"/><TextBlock Name="UpscalingInfo" Style="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/></StackPanel>
          </Grid>
          <Border BorderBrush="#333D4B" BorderThickness="0,1,0,0" Margin="0,28,0,0" Padding="0,22,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="FPS" FontWeight="SemiBold"/><TextBlock Text="Physics follows elapsed game time. For even VSync pacing, choose an FPS target that divides the display refresh rate. Targets above 120 FPS remain experimental." Style="{StaticResource Muted}" Margin="0,6,24,0"/><CheckBox Name="ShowFps" Content="Show in-game FPS counter" Margin="0,14,0,0"/></StackPanel>
            <ComboBox Name="FrameRate" Grid.Column="1" VerticalAlignment="Top" AutomationProperties.Name="Frame rate target"/>
          </Grid></Border>
          <TextBlock Text="Changes apply the next time you start the game. The graphics mode required for 3D rendering is preserved." Style="{StaticResource Muted}" FontSize="12" Margin="0,24,0,0"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Controls">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Controllers and bindings" Style="{StaticResource Heading}"/><TextBlock Text="Two local players are supported. For keyboard + controller, assign the keyboard to Exclusive · player 2, then press its A / Confirm binding to join. Profiles 3 and 4 are reserved for future support." Style="{StaticResource Muted}" Margin="0,0,0,18"/></StackPanel>
          <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="310"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Profile" Margin="0,0,0,6"/><ComboBox Name="Player" AutomationProperties.Name="Player profile"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Controller for this player" Margin="0,0,0,6"/><ComboBox Name="Device" AutomationProperties.Name="Player controller"/></StackPanel>
            <StackPanel Grid.Column="4"><TextBlock Text="Keyboard and mouse" Margin="0,0,0,6"/><ComboBox Name="KeyboardPlayer" AutomationProperties.Name="Keyboard and mouse player"/></StackPanel>
            <Button Name="RefreshDevices" Grid.Column="5" Content="Refresh" VerticalAlignment="Bottom" Margin="10,0,0,0" Padding="10,8"/>
          </Grid>
          <DataGrid Name="Bindings" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="Column" SelectionMode="Single" Background="#1B212A" Foreground="#F1F3F7" BorderBrush="#354051" BorderThickness="1" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2A3340" RowHeaderWidth="0" VerticalScrollBarVisibility="Auto"/>
          <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0"><Button Name="RestoreBindings" Content="Reset this profile" Padding="12,6"/><TextBlock Name="CaptureHint" Text="Capture: keyboard/mouse. Double-click a cell to edit the controller binding." Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/></StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Online">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="Online play" Style="{StaticResource Heading}"/>
          <TextBlock Text="Your player name is shown in game and in the room." Style="{StaticResource Muted}" Margin="0,0,0,12"/>
          <TextBlock Text="Player name" Margin="0,0,0,7"/>
          <TextBox Name="PlayerName" Width="360" HorizontalAlignment="Left" MaxLength="15" AutomationProperties.Name="Online player name"/>
          <TextBlock Name="NameValidation" Text="1–15 characters: A–Z, numbers, internal spaces, hyphens or underscores." Style="{StaticResource Muted}" Margin="0,8,0,14"/>
          <Border BorderBrush="#333D4B" BorderThickness="0,1,0,0" Padding="0,14,0,0"><StackPanel>
            <TextBlock Text="In-game matchmaking" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
            <CheckBox Name="EosEnabled" Content="Enable online play through Epic Online Services" Margin="0,0,0,10"/>
            <TextBlock Text="Click Play, then open Online → Player Match in the game. Public matches are found in game without an invitation or a room server address. The host's game must stay open." Style="{StaticResource Muted}" Margin="0,0,0,10" MaxWidth="740" HorizontalAlignment="Left"/>
            <TextBlock Name="EosState" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
            <TextBlock Text="Epic friends, private invitations and ranked services are not available in this test build." Style="{StaticResource Muted}" Margin="0,0,0,20"/>
            <TextBlock Text="Players on this PC" Margin="0,0,0,7"/>
            <ComboBox Name="OnlineLocalPlayers" Width="360" HorizontalAlignment="Left" AutomationProperties.Name="Local players in online room" Margin="0,0,0,20"/>
            <Expander Header="Legacy WebRTC rooms" Foreground="#F1F3F7" Margin="0,0,0,20"><StackPanel Margin="0,12,0,0">
            <TextBlock Text="Host: create a room and send the invitation to your friends. To join, paste the invitation below. A public room server is not available yet; the host must configure one." Style="{StaticResource Muted}" Margin="0,0,0,14" MaxWidth="740" HorizontalAlignment="Left"/>
            <Expander Header="Room server settings" Foreground="#F1F3F7" Margin="0,0,0,18"><StackPanel Margin="0,12,0,0">
              <TextBlock Text="Room server address" Margin="0,0,0,7"/>
              <TextBox Name="OnlineServer" MaxWidth="700" HorizontalAlignment="Stretch" MaxLength="512" AutomationProperties.Name="Room server address"/>
              <TextBlock Text="Hosts enter their room server address here. Invitations fill this in for joining players." Style="{StaticResource Muted}" Margin="0,8,0,0"/>
            </StackPanel></Expander>
            <TextBlock Text="Room mode" Margin="0,0,0,7"/><ComboBox Name="OnlineMode" AutomationProperties.Name="Online room mode" Margin="0,0,0,18"/>
            <TextBlock Text="Invitation or room code" Margin="0,0,0,7"/>
            <TextBox Name="RoomCode" MaxWidth="700" HorizontalAlignment="Stretch" MaxLength="1024" AutomationProperties.Name="Invitation or room code"/>
            <WrapPanel Margin="0,12,0,12">
              <Button Name="CreateRoom" Content="Create room" Margin="0,0,10,8"/>
              <Button Name="JoinRoom" Content="Join room" Margin="0,0,10,8"/>
              <Button Name="CopyRoom" Content="Copy invitation" IsEnabled="False" Margin="0,0,10,8"/>
              <Button Name="LeaveRoom" Content="Leave room" IsEnabled="False" Margin="0,0,0,8"/>
            </WrapPanel>
            <TextBlock Name="OnlineState" Text="No room connected." Style="{StaticResource Muted}" Margin="0,0,0,14"/>
            <TextBlock Text="After connecting, click Play. In the game, choose Online → Player Match → Find Game. The host selects a mode first; friends then select the same mode. Keep the launcher open while playing." Style="{StaticResource Muted}" Margin="0,0,0,24" MaxWidth="740" HorizontalAlignment="Left"/>
            </StackPanel></Expander>
            <Expander Header="Local network" Foreground="#F1F3F7" Margin="0,0,0,14"><StackPanel Margin="0,12,0,0">
            <CheckBox Name="LanEnabled" Content="Enable experimental LAN play" Margin="0,0,0,14"/>
            <TextBlock Text="Host IPv4 address" Margin="0,0,0,7"/>
            <TextBox Name="LanPeer" Width="360" HorizontalAlignment="Left" MaxLength="15" AutomationProperties.Name="LAN host IPv4 address"/>
            <TextBlock Text="255.255.255.255 discovers hosts on your local network. If discovery fails, enter the host PC's IPv4 address on joining PCs." Style="{StaticResource Muted}" Margin="0,8,0,14" MaxWidth="740" HorizontalAlignment="Left"/>
            <TextBlock Text="In game: Online → Player Match → Find Game. Choose the same mode and options on each PC. An empty search creates a public match. Team DogFight has been tested between two local game instances; testing on separate PCs is still needed." Style="{StaticResource Muted}" Margin="0,0,0,14" MaxWidth="740" HorizontalAlignment="Left"/>
            <TextBlock Text="A connected online room takes precedence over LAN. Direct connections use WebRTC; a configured TURN server provides relay fallback. Ranked services and rollback are not implemented." Style="{StaticResource Muted}" Margin="0,10,0,0" MaxWidth="740" HorizontalAlignment="Left"/>
            </StackPanel></Expander>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Update">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="Project updates" Style="{StaticResource Heading}"/>
          <TextBlock Text="Check GitHub for a published RedBaron_Recomp release. The downloaded package is verified using GitHub's SHA-256 before it is saved." Style="{StaticResource Muted}" Margin="0,0,0,24" MaxWidth="740" HorizontalAlignment="Left"/>
          <TextBlock Text="Current version" Margin="0,0,0,7"/><TextBlock Text="0.10 — test build" FontSize="16" Margin="0,0,0,22"/>
          <TextBlock Name="UpdateState" Text="Checking for releases…" Style="{StaticResource Muted}" Margin="0,0,0,18"/>
          <WrapPanel><Button Name="CheckUpdates" Content="Check for updates" Margin="0,0,10,8"/><Button Name="DownloadUpdate" Content="Download update" IsEnabled="False" Margin="0,0,10,8"/><Button Name="OpenUpdates" Content="Open downloads folder" IsEnabled="False" Margin="0,0,10,8"/><Button Name="OpenLogs" Content="Open logs folder" Margin="0,0,0,8"/></WrapPanel>
          <TextBlock Text="No game files are included in the download. Public releases are not available until the project is ready." Style="{StaticResource Muted}" Margin="0,14,0,0" MaxWidth="740" HorizontalAlignment="Left"/>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="#1C2028" BorderBrush="#343E4C" BorderThickness="0,1,0,0" Padding="28,16,28,20">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,18,0"><TextBlock Name="Status" Text="Loading settings…" TextWrapping="Wrap" Foreground="#B7C6BC" Margin="0,0,0,10"/><CheckBox Name="ShowLauncher" Content="Show launcher next time"/><TextBlock Text="Hold Shift while opening the shortcut to return to settings." Foreground="#AEB9CA" FontSize="11" Margin="0,6,0,0"/></StackPanel>
        <Button Name="Save" Grid.Column="1" Content="Save" VerticalAlignment="Center" Margin="0,0,12,0" MinHeight="44"/>
        <Button Name="Play" Grid.Column="2" Content="Play" Style="{StaticResource Primary}" VerticalAlignment="Center" FontSize="17" MinHeight="44"/>
      </Grid>
    </Border>
  </Grid>
</Window>
