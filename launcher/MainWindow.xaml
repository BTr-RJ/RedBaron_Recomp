<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RedBaron_Recomp" Width="1060" Height="820" MinWidth="920" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#15191F" Foreground="#F1F3F7"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="InputBackground" Color="#252C36"/>
    <SolidColorBrush x:Key="InputBorder" Color="#455161"/>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#AEB9CA"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="22"/></Style>
    <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#2A333F"/><Setter Property="Foreground" Value="#F1F3F7"/>
      <Setter Property="BorderBrush" Value="#455161"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,9"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#B7C3D5"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#F1F3F7"/><Setter TargetName="Border" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Opacity" Value="0.75"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#BA343D"/><Setter Property="BorderBrush" Value="#BA343D"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource InputBackground}"/><Setter Property="Foreground" Value="#F1F3F7"/>
      <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/><Setter Property="CaretBrush" Value="#FFFFFF"/>
      <Setter Property="SelectionBrush" Value="#99404A"/><Setter Property="Padding" Value="10,8"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#E28B90"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#252C36"/><Setter Property="Foreground" Value="#F1F3F7"/><Setter Property="Padding" Value="10,8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Item" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#3D4859"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#51303A"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#919BAC"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{StaticResource InputBackground}"/><Setter Property="Foreground" Value="#F1F3F7"/>
      <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/><Setter Property="MinHeight" Value="38"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border Background="#252C36" BorderBrush="#455161" BorderThickness="1" CornerRadius="3"><Grid><Path Data="M 0 0 L 4 4 L 8 0" Stroke="#C8D1DF" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Grid></Border>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Margin="12,7,32,7" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
            <Border Background="#252C36" BorderBrush="#718096" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="340">
              <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E1E6EE"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#B9C3D2"/><Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="24,14"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="Tab" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}">
          <ContentPresenter ContentSource="Header"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/><Setter TargetName="Tab" Property="BorderBrush" Value="#E0646D"/><Setter TargetName="Tab" Property="Background" Value="#242830"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#202731"/><Setter Property="Foreground" Value="#BFC9D9"/><Setter Property="Padding" Value="10,10"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#3C4757"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,2"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#F1F3F7"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#3A3340"/></Trigger></Style.Triggers></Style>
    <Style TargetType="DataGridRow"><Setter Property="Background" Value="#1B212A"/><Setter Property="MinHeight" Value="42"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#302D39"/></Trigger></Style.Triggers></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#1C2028" BorderBrush="#323A47" BorderThickness="0,0,0,1" Padding="28,0">
      <Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="RedBaron_Recomp" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Snoopy Flying Ace · PC" Foreground="#ACB7C8" FontSize="12" Margin="0,4,0,0"/></StackPanel>
        <TextBlock Name="HeaderStatus" Text="Verificando instalação…" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#B7C6BC"/>
      </Grid>
    </Border>
    <TabControl Name="Tabs" Grid.Row="1" Background="#15191F" BorderThickness="0" Foreground="#F1F3F7" Padding="28,24,28,12">
      <TabItem Header="Install">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="Instalar o jogo" Style="{StaticResource Heading}"/>
          <TextBlock Text="Selecione os dados locais e uma pasta vazia. O launcher prepara e compila o port para essa instalação." Style="{StaticResource Muted}" Margin="0,0,0,24"/>
          <TextBlock Text="Arquivos do jogo" Margin="0,0,0,7"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBox Name="SourcePath" AutomationProperties.Name="Pasta dos arquivos do jogo"/><Button Name="BrowseSource" Content="Procurar…" Grid.Column="1" Margin="10,0,0,0"/></Grid>
          <TextBlock Text="Pasta já extraída, contendo default.xex, Config e Packages. Pacotes STFS ainda não são extraídos pelo launcher." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,20"/>
          <TextBlock Text="Pasta de instalação" Margin="0,0,0,7"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBox Name="DestinationPath" AutomationProperties.Name="Pasta de destino"/><Button Name="BrowseDestination" Content="Procurar…" Grid.Column="1" Margin="10,0,0,0"/></Grid>
          <CheckBox Name="DesktopShortcut" Content="Criar atalho do jogo na área de trabalho" Margin="0,16,0,20"/>
          <Expander Foreground="#D5DDE9" Header="Ferramentas de compilação" IsExpanded="False">
            <StackPanel Margin="0,12,0,0"><TextBlock Text="SDK ReXGlue instalado" Margin="0,0,0,7"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions><TextBox Name="SdkPath" AutomationProperties.Name="Pasta do SDK"/><Button Name="BrowseSdk" Content="Procurar…" Grid.Column="1" Margin="10,0,0,0"/></Grid>
              <TextBlock Text="Requer o SDK compatível com este port, CMake, Ninja e Clang no PC. Nenhum arquivo do jogo é baixado." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,14"/>
            </StackPanel>
          </Expander>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,14"><Button Name="InstallButton" Content="Instalar e compilar" Style="{StaticResource Primary}"/><Button Name="CancelInstall" Content="Cancelar instalação" Margin="10,0,0,0" Visibility="Collapsed"/><Button Name="UseExisting" Content="Usar instalação existente…" Margin="10,0,0,0"/></StackPanel>
          <ProgressBar Name="InstallProgress" Height="5" Background="#2C3440" Foreground="#D65F68" IsIndeterminate="True" Visibility="Collapsed"/>
          <TextBlock Name="InstallState" Style="{StaticResource Muted}" Margin="0,10,0,8"/>
          <TextBox Name="InstallLog" IsReadOnly="True" Height="120" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12" Visibility="Collapsed"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Video">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="Imagem e desempenho" Style="{StaticResource Heading}"/>
          <TextBlock Name="GpuSummary" Text="Detectando GPU e opções disponíveis…" Style="{StaticResource Muted}" Margin="0,0,0,24"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="GPU" Margin="0,0,0,7"/><ComboBox Name="Gpu" AutomationProperties.Name="GPU"/><TextBlock Text="Resolução" Margin="0,20,0,7"/><ComboBox Name="Resolution" AutomationProperties.Name="Resolução"/><TextBlock Text="Modo de exibição" Margin="0,20,0,7"/><ComboBox Name="DisplayMode" AutomationProperties.Name="Modo de exibição"/><CheckBox Name="Vsync" Content="VSync · sincronização vertical" Margin="0,22,0,0"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Filtro anisotrópico" Margin="0,0,0,7"/><ComboBox Name="Anisotropic" AutomationProperties.Name="Filtro anisotrópico"/><TextBlock Text="Antialiasing" Margin="0,20,0,7"/><ComboBox Name="Antialiasing" AutomationProperties.Name="Antialiasing"/><TextBlock Text="Upscaling" Margin="0,20,0,7"/><ComboBox Name="Upscaling" AutomationProperties.Name="Upscaling"/><TextBlock Name="UpscalingInfo" Style="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/></StackPanel>
          </Grid>
          <Border BorderBrush="#333D4B" BorderThickness="0,1,0,0" Margin="0,28,0,0" Padding="0,22,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="FPS" FontWeight="SemiBold"/><TextBlock Text="Sem alteração da taxa de quadros do jogo. 90/120 FPS exigem implementação e testes; VSync não é um desbloqueio de FPS." Style="{StaticResource Muted}" Margin="0,6,24,0"/></StackPanel>
            <ComboBox Grid.Column="1" IsEnabled="False" SelectedIndex="0" VerticalAlignment="Top" AutomationProperties.Name="FPS indisponível para alteração"><ComboBoxItem Content="Padrão do jogo · sem desbloqueio"/></ComboBox>
          </Grid></Border>
          <TextBlock Text="As mudanças entram em vigor na próxima abertura do jogo. O modo gráfico compatível com o 3D desta versão é preservado." Style="{StaticResource Muted}" FontSize="12" Margin="0,24,0,0"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Controls">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Controles e comandos" Style="{StaticResource Heading}"/><TextBlock Text="Funções do preset FlyingAce. Configure os quatro perfis; apenas o jogador 1 está funcional em partidas nesta versão." Style="{StaticResource Muted}" Margin="0,0,0,18"/></StackPanel>
          <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="310"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Perfil" Margin="0,0,0,6"/><ComboBox Name="Player" AutomationProperties.Name="Perfil de jogador"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Controle deste jogador" Margin="0,0,0,6"/><ComboBox Name="Device" AutomationProperties.Name="Controle do jogador"/></StackPanel>
            <StackPanel Grid.Column="4"><TextBlock Text="Teclado e mouse" Margin="0,0,0,6"/><ComboBox Name="KeyboardPlayer" AutomationProperties.Name="Jogador do teclado e mouse"/></StackPanel>
            <Button Name="RefreshDevices" Grid.Column="5" Content="Atualizar" VerticalAlignment="Bottom" Margin="10,0,0,0" Padding="10,8"/>
          </Grid>
          <DataGrid Name="Bindings" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="Column" SelectionMode="Single" Background="#1B212A" Foreground="#F1F3F7" BorderBrush="#354051" BorderThickness="1" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2A3340" RowHeaderWidth="0" VerticalScrollBarVisibility="Auto"/>
          <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0"><Button Name="RestoreBindings" Content="Restaurar este perfil" Padding="12,6"/><TextBlock Name="CaptureHint" Text="Capturar: teclado/mouse. Duplo clique na célula para editar o controle." Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/></StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Online">
        <StackPanel>
          <TextBlock Text="Identidade do jogador" Style="{StaticResource Heading}"/>
          <TextBlock Text="Guarde seu nome para a futura integração online. A conexão multiplayer foi adiada." Style="{StaticResource Muted}" Margin="0,0,0,26"/>
          <TextBlock Text="Nome do jogador" Margin="0,0,0,7"/>
          <TextBox Name="PlayerName" Width="360" HorizontalAlignment="Left" MaxLength="15" AutomationProperties.Name="Nome do jogador online"/>
          <TextBlock Name="NameValidation" Text="1–15 caracteres: A–Z, números, espaço interno, hífen ou sublinhado." Style="{StaticResource Muted}" Margin="0,8,0,26"/>
          <Border BorderBrush="#333D4B" BorderThickness="0,1,0,0" Padding="0,24,0,0"><StackPanel>
            <TextBlock Text="Conexão" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
            <CheckBox Content="Configurar portas automaticamente com UPnP" IsEnabled="False"/>
            <TextBlock Text="Indisponível enquanto o modo online não estiver implementado. Nenhuma porta do roteador será aberta nesta versão." Style="{StaticResource Muted}" Margin="0,10,0,0" MaxWidth="640" HorizontalAlignment="Left"/>
          </StackPanel></Border>
        </StackPanel>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="#1C2028" BorderBrush="#343E4C" BorderThickness="0,1,0,0" Padding="28,16,28,20">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,18,0"><TextBlock Name="Status" Text="Carregando configurações…" Foreground="#B7C6BC" Margin="0,0,0,10"/><CheckBox Name="ShowLauncher" Content="Abrir o launcher na próxima vez"/><TextBlock Text="Para voltar às configurações, mantenha Shift ao abrir o atalho." Foreground="#AEB9CA" FontSize="11" Margin="0,6,0,0"/></StackPanel>
        <Button Name="Save" Grid.Column="1" Content="Save" VerticalAlignment="Center" Margin="0,0,12,0" MinHeight="44"/>
        <Button Name="Play" Grid.Column="2" Content="Play" Style="{StaticResource Primary}" VerticalAlignment="Center" FontSize="17" MinHeight="44"/>
      </Grid>
    </Border>
  </Grid>
</Window>
