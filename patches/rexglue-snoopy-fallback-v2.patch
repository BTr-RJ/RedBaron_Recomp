   uint32_t target = insn.operands[1];
 
+  // A verified multi-entry group owns this label, even if the graph still
+  // registers the target as a separate callable entry point.
+  if (isLocalMergedTarget(target)) {
+    println("\tif ({}{}.{}) goto loc_{:08X};", not_ ? "!" : "", cr(insn.operands[0]), cond,
+            target);
+    return;
+  }
+
+  // SNOOPY V2: EXACT SITE CROSS-CHUNK BRANCH FALLBACK BEGIN
+  // The CONFIG/PDATA containsAddress() includes declared function ranges,
+  // even when a destination has no block/label in THIS emitted C++ body.
+  // The graph classified these three cross-chunk branches as InternalLabel;
+  // a local C++ goto fails if the label is emitted in a different function.
+  // Never rewrite the identical branch emitted WITHIN its destination chunk.
+  // Only test the three independently verified (source fn, PPC site, target)
+  // tuples; preserve real local gotos and SEH-bearing functions.
+  const bool snoopyCrossChunkSite =
+      (fn.base() == 0x82362A58u && base == 0x82362B18u && target == 0x82362ABCu) ||
+      (fn.base() == 0x82362B6Cu && base == 0x82362BB4u && target == 0x82362B98u) ||
+      (fn.base() == 0x82362B6Cu && base == 0x82362C20u && target == 0x82362BC4u);
+
+  if (snoopyCrossChunkSite && !fn.hasExceptionInfo()) {
+    const auto& configured = config().functions;
+    const auto srcIt = configured.find(fn.base());
+    const auto dstIt = configured.find(target);
+    const auto* destFn = graph().getFunction(target);
+    // Do not use fn.containsAddress(target): for CONFIG functions it checks
+    // the declared interval, not necessarily the actually emitted blocks.
+    // Also don't redirect if the label IS in this function's own blocks.
+    const bool hasActualLocalBlock = std::any_of(
+        fn.blocks().begin(), fn.blocks().end(),
+        [target](const Block& block) { return block.contains(target); });
+
+    if (!hasActualLocalBlock && srcIt != configured.end() &&
+        dstIt != configured.end() && destFn &&
+        srcIt->second.isChunk() && dstIt->second.isChunk() &&
+        srcIt->second.parent == dstIt->second.parent &&
+        dstIt->second.mergeWithParent && destFn->isSealed() &&
+        !destFn->hasExceptionInfo() &&
+        graph().classifyTarget(target, base, false) == TargetKind::InternalLabel) {
+      emitCtx.reference(destFn->name());
+      println("\tif ({}{}.{}) {{", not_ ? "!" : "", cr(insn.operands[0]), cond);
+      println("\t\t{}(ctx, base);", destFn->name());
+      println("\t\treturn;");
+      println("\t}}");
+      REXCODEGEN_WARN("SNOOPY-V2-FALLBACK site=0x{:08X} src=0x{:08X} dest=0x{:08X}",
