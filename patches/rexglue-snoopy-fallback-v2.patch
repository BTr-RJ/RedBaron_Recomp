+                    base, fn.base(), target,
+                    static_cast<int>(hasActualLocalBlock),
+                    static_cast<int>(srcIt != configured.end()),
+                    static_cast<int>(dstIt != configured.end()),
+                    static_cast<int>(destFn != nullptr),
+                    static_cast<int>(destFn && destFn->isSealed()));
+  }
+  // SNOOPY V2: EXACT SITE CROSS-CHUNK BRANCH FALLBACK END
+
   // Use classifyTarget for consistent branch classification
