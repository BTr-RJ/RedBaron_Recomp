+u32 NetDll_XNetQosLookup_entry(u32 caller, u32 count, mapped_void addresses, mapped_void ids,
+    mapped_void keys, u32 gateways, mapped_void gateway_addresses, mapped_void services,
+    u32 probes, u32 bits_per_second, u32 flags, u32 event_handle, mapped_u32 result_ptr) {
+  if (!result_ptr) return 10014;
+  *result_ptr = 0;
+  if (!LanEnabled() || count > 32 || gateways || !count || !addresses || !ids || flags) return 10022;
+  auto* mem = REX_KERNEL_MEMORY(); std::vector<LanQosTarget> targets;
+  for (uint32_t i = 0; i < count; ++i) {
+    auto a = uint32_t(addresses.as_array<uint32_t>()[i]), id = uint32_t(ids.as_array<uint32_t>()[i]);
+    if (!a || !id || !mem->LookupHeap(a) || !mem->LookupHeap(a + 35) || !mem->LookupHeap(id) || !mem->LookupHeap(id + 7)) return 10014;
+    auto* address = mem->TranslateVirtual<XNADDR*>(a);
+    LanQosTarget target; target.address = ntohl(address->ina.s_addr);
+    if (!target.address) target.address = ntohl(address->inaOnline.s_addr);
+    std::memcpy(target.id.data(), mem->TranslateVirtual(id), 8); targets.push_back(target);
+  }
+  auto results = LanQosProbe(targets, probes);
+  uint32_t size = 8 + count * sizeof(XNQOSINFO);
+  for (const auto& result : results) size += uint32_t(result.data.size());
+  const auto allocation = mem->SystemHeapAlloc(size); if (!allocation) return 10055;
+  auto* out = mem->TranslateVirtual<XNQOS*>(allocation); std::memset(out, 0, size);
+  out->count = count; out->count_pending = 0;
+  uint32_t offset = 8 + count * sizeof(XNQOSINFO);
+  auto* info = reinterpret_cast<XNQOSINFO*>(reinterpret_cast<uint8_t*>(out) + 8);
+  for (uint32_t i = 0; i < count; ++i) {
+    const auto& result = results[i];
+    info[i].flags = 1 | (result.contacted ? 2 : 0) | (result.disabled ? 4 : 0) | (!result.data.empty() ? 8 : 0);
+    info[i].probes_xmit = result.sent; info[i].probes_recv = result.received;
+    info[i].rtt_min_in_msecs = result.minimum_ms; info[i].rtt_med_in_msecs = result.median_ms;
+    info[i].data_len = uint16_t(result.data.size());
+    if (!result.data.empty()) {
+      info[i].data_ptr = allocation + offset;
+      std::memcpy(reinterpret_cast<uint8_t*>(out) + offset, result.data.data(), result.data.size()); offset += uint32_t(result.data.size());
+    }
+    // RTT/data probes do not measure available bandwidth; leave it unknown (0).
+  }
+  *result_ptr = allocation;
+  if (event_handle) {
+    auto event = REX_KERNEL_OBJECTS()->LookupObject<XEvent>(event_handle);
+    if (event) event->Set(0, false);
+  }
+  return 0;
 }
 
