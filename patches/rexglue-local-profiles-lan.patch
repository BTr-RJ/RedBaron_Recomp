+#include <optional>
+#include <rex/system/xobject.h>
+
+namespace rex::system {
+class XSession final : public XObject {
+ public:
+  static constexpr Type kObjectType = Type::Session;
+  explicit XSession(KernelState* kernel);
+  ~XSession() override;
+  X_STATUS Initialize();
+  static std::optional<X_HRESULT> Dispatch(KernelState* kernel, uint32_t message,
+                                         uint32_t buffer, uint32_t length);
+ private:
+  struct Member { uint64_t xuid; uint32_t index; bool private_slot; };
+  std::mutex mutex_;
+  bool created_ = false;
+  bool advertised_ = false;
+  uint32_t flags_ = 0, owner_ = 0, public_slots_ = 0, private_slots_ = 0, state_ = 0;
+  uint64_t nonce_ = 0;
+  std::array<uint8_t, 60> info_{};
+  std::map<uint64_t, Member> members_;
+};
+}
