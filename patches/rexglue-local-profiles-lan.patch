+constexpr uint16_t kDiscoveryPort = 43821;
+constexpr size_t kMaxPacket = 8192;
+using Bytes = std::vector<uint8_t>;
+void Put(Bytes& out, uint32_t value) {
+  for (int shift = 24; shift >= 0; shift -= 8) out.push_back(uint8_t(value >> shift));
+}
+struct Reader {
+  const uint8_t* at; size_t left;
+  bool Take(void* dest, size_t n) {
+    if (n > left) return false;
+    std::memcpy(dest, at, n); at += n; left -= n; return true;
+  }
+  bool Get(uint32_t& value) {
+    if (left < 4) return false;
+    value = (uint32_t(at[0]) << 24) | (uint32_t(at[1]) << 16) | (uint32_t(at[2]) << 8) | at[3];
+    at += 4; left -= 4; return true;
+  }
+};
+struct Socket {
+  SOCKET value = INVALID_SOCKET;
+  ~Socket() { if (value != INVALID_SOCKET) closesocket(value); }
+};
+bool InitSockets() {
+  static const bool ready = [] { WSADATA data{}; return WSAStartup(MAKEWORD(2,2), &data) == 0; }();
+  return ready;
+}
+uint32_t ParseIp(const std::string& text) {
+  in_addr address{};
+  return inet_pton(AF_INET, text.c_str(), &address) == 1 ? ntohl(address.s_addr) : 0;
+}
+sockaddr_in Address(uint32_t ip, uint16_t port) {
+  sockaddr_in out{}; out.sin_family = AF_INET; out.sin_addr.s_addr = htonl(ip); out.sin_port = htons(port); return out;
+}
+LanSessionId Id(const LanRecord& record) {
+  LanSessionId id; std::copy_n(record.info.begin(), 8, id.begin()); return id;
+}
+Bytes Encode(const LanRecord& record, const uint8_t* query) {
+  Bytes data(query, query + 16); data[7] = 2;
+  Put(data, record.title); data.insert(data.end(), record.info.begin(), record.info.end());
+  for (auto slots : {record.open_public, record.open_private, record.filled_public, record.filled_private}) Put(data, slots);
+  Put(data, uint32_t(record.contexts.size())); Put(data, uint32_t(record.properties.size()));
+  for (auto [key, value] : record.contexts) { Put(data, key); Put(data, value); }
+  for (const auto& [key, value] : record.properties) {
+    Put(data, key); Put(data, uint32_t(value.size())); data.insert(data.end(), value.begin(), value.end());
+  }
+  return data;
+}
+bool Decode(const uint8_t* data, size_t size, const uint8_t* query, LanRecord& out) {
+  if (size < 16 || std::memcmp(data, query, 7) || data[7] != 2 || std::memcmp(data + 8, query + 8, 8)) return false;
+  Reader r{data + 16, size - 16}; uint32_t contexts, properties;
+  if (!r.Get(out.title) || !r.Take(out.info.data(), 60) || !r.Get(out.open_public) || !r.Get(out.open_private) ||
+      !r.Get(out.filled_public) || !r.Get(out.filled_private) || !r.Get(contexts) || !r.Get(properties) || contexts > 32 || properties > 32) return false;
+  if (uint64_t(out.open_public) + out.open_private + out.filled_public + out.filled_private > 32) return false;
+  for (uint32_t i = 0, key, value; i < contexts; ++i) {
+    if (!r.Get(key) || !r.Get(value) || !out.contexts.emplace(key, value).second) return false;
+  }
+  for (uint32_t i = 0, key, length; i < properties; ++i) {
+    if (!r.Get(key) || !r.Get(length) || length > 1024 || out.properties.contains(key)) return false;
+    auto& value = out.properties[key]; value.resize(length);
+    if (!r.Take(value.data(), length)) return false;
+  }
+  return r.left == 0;
+}
+class Lobby {
+ public:
+  struct Qos { bool enabled = false; Bytes data; };
+  std::mutex mutex;
+  std::map<LanSessionId, LanRecord> records;
+  std::map<LanSessionId, Qos> qos;
+  std::array<LanRecord, 4> attributes;
+  Socket listener;
+  std::jthread thread;
+  bool Start() {
+    if (listener.value != INVALID_SOCKET) return true;
+    listener.value = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    auto address = Address(ParseIp(REXCVAR_GET(redbaron_lan_bind)), kDiscoveryPort);
+    if (listener.value == INVALID_SOCKET || bind(listener.value, reinterpret_cast<sockaddr*>(&address), sizeof(address)) != 0) {
+      REXLOG_ERROR("LAN discovery could not bind UDP {}: {}", kDiscoveryPort, WSAGetLastError());
+      if (listener.value != INVALID_SOCKET) closesocket(listener.value);
+      listener.value = INVALID_SOCKET; return false;
+    }
+    thread = std::jthread([this](std::stop_token stop) {
+      auto window = std::chrono::steady_clock::now(); unsigned queries = 0;
+      while (!stop.stop_requested()) {
+        fd_set read; FD_ZERO(&read); FD_SET(listener.value, &read); timeval timeout{0, 50000};
+        if (select(0, &read, nullptr, nullptr, &timeout) <= 0) continue;
+        uint8_t query[32]{}; sockaddr_in sender{}; int length = sizeof(sender);
+        int count = recvfrom(listener.value, reinterpret_cast<char*>(query), sizeof(query), 0, reinterpret_cast<sockaddr*>(&sender), &length);
+        if (count < 20 || std::memcmp(query, "RBLAN01", 7)) continue;
+        const auto now = std::chrono::steady_clock::now();
+        if (now - window >= std::chrono::seconds(1)) { queries = 0; window = now; }
+        if (++queries > 128) continue;
+        if (query[7] == 3 && count == 24) {
+          LanSessionId id; std::copy_n(query + 16, 8, id.begin());
+          Bytes response(query, query + 24); response[7] = 4;
+          { std::lock_guard lock(mutex); auto found = qos.find(id);
+            if (found == qos.end()) continue;
+            Put(response, found->second.enabled ? 1 : 0);
+            const auto& data = found->second.data;
+            Put(response, found->second.enabled ? uint32_t(data.size()) : 0);
+            if (found->second.enabled) response.insert(response.end(), data.begin(), data.end());
+          }
+          sendto(listener.value, reinterpret_cast<const char*>(response.data()), int(response.size()), 0, reinterpret_cast<sockaddr*>(&sender), length);
+          continue;
+        }
+        if (query[7] != 1 || count != 20) continue;
+        uint32_t title = 0; Reader{query + 16, 4}.Get(title);
+        std::vector<LanRecord> snapshot;
+        { std::lock_guard lock(mutex); for (const auto& [id, saved] : records) {
+            if (saved.title != title) continue;
+            auto copy = saved; copy.contexts = attributes[copy.owner].contexts; copy.properties = attributes[copy.owner].properties;
+            snapshot.push_back(std::move(copy));
+        } }
+        for (const auto& record : snapshot) {
+          auto data = Encode(record, query);
+          if (data.size() <= kMaxPacket) sendto(listener.value, reinterpret_cast<const char*>(data.data()), int(data.size()), 0, reinterpret_cast<sockaddr*>(&sender), length);
+        }
+      }
+    });
+    return true;
+  }
+};
+Lobby& State() { static Lobby lobby; return lobby; }
+}
+bool LanEnabled() { return REXCVAR_GET(redbaron_lan) && InitSockets(); }
+uint32_t LanBindAddress() { return ParseIp(REXCVAR_GET(redbaron_lan_bind)); }
+uint32_t LanAddress() {
+  uint32_t configured = ParseIp(REXCVAR_GET(redbaron_lan_bind));
+  if (configured) return configured;
+  if (!InitSockets()) return 0;
+  // Route selection does not send a packet. It selects the interface for the peer.
+  Socket probe; probe.value = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+  auto peer = Address(ParseIp(REXCVAR_GET(redbaron_lan_peer)), kDiscoveryPort);
+  int yes = 1; setsockopt(probe.value, SOL_SOCKET, SO_BROADCAST, reinterpret_cast<char*>(&yes), sizeof(yes));
+  if (connect(probe.value, reinterpret_cast<sockaddr*>(&peer), sizeof(peer)) == 0) {
+    sockaddr_in local{}; int length = sizeof(local);
+    if (getsockname(probe.value, reinterpret_cast<sockaddr*>(&local), &length) == 0) return ntohl(local.sin_addr.s_addr);
+  }
+  return 0;
+}
+uint64_t LanUserId(uint32_t index) {
+  static const uint64_t machine = [] {
+    auto path = Runtime::instance()->user_data_root() / "redbaron-network-id.bin";
+    uint64_t identity = 0; std::ifstream input(path, std::ios::binary); input.read(reinterpret_cast<char*>(&identity), 8);
+    if (!input || (identity & 0xFF) || (identity >> 48) != 9) {
+      // XAM validates the online-shaped XUID prefix, even for our LAN service.
+      // This is a locally generated identity, not an Xbox Live account.
+      std::random_device random; identity = 0x0009000000000000ull | (((uint64_t(random()) << 32) | random()) & 0x0000FFFFFFFFFF00ull);
+      std::filesystem::create_directories(path.parent_path());
+      std::ofstream output(path, std::ios::binary); output.write(reinterpret_cast<const char*>(&identity), 8);
+    }
+    return identity;
+  }();
+  return machine + index;
+}
+std::array<uint8_t,36> LanXnAddress() {
+  std::array<uint8_t,36> out{}; uint32_t ip = LanAddress();
+  for (unsigned i = 0; i < 4; ++i) out[i] = out[i+4] = uint8_t(ip >> (24 - i*8));
+  out[8] = 12; out[9] = 2; // UDP 3074, Xbox system-link default.
+  uint64_t id = LanUserId(0);
+  for (unsigned i = 0; i < 6; ++i) out[10+i] = uint8_t(id >> (8 + i*8));
+  out[10] = (out[10] & 0xFC) | 2; // Locally administered unicast identifier.
+  std::copy_n(out.begin()+10, 6, out.begin()+16);
+  return out;
+}
+bool LanPublish(LanRecord record) {
+  if (!LanEnabled() || record.owner >= 4) return false;
+  auto& lobby = State(); std::lock_guard lock(lobby.mutex);
+  if (lobby.records.size() >= 8 && !lobby.records.contains(Id(record))) return false;
+  if (!lobby.Start()) return false;
+  lobby.records[Id(record)] = std::move(record); return true;
+}
+void LanRemove(const LanSessionId& id) { auto& s = State(); std::lock_guard lock(s.mutex); s.records.erase(id); }
+bool LanQosListen(const LanSessionId& id, uint32_t flags, std::vector<uint8_t> data) {
+  if (!LanEnabled() || (flags & ~31u) || ((flags & 3) == 3) || data.size() > 1024) return false;
+  auto& s = State(); std::lock_guard lock(s.mutex);
+  if (flags & 16) { s.qos.erase(id); return true; }
+  if (s.qos.size() >= 16 && !s.qos.contains(id)) return false;
+  if (!s.Start()) return false;
+  auto& entry = s.qos[id];
+  if (flags & 1) entry.enabled = true;
+  if (flags & 2) entry.enabled = false;
+  if (flags & 4) entry.data = std::move(data);
+  return true;
+}
+std::vector<LanQosResult> LanQosProbe(const std::vector<LanQosTarget>& targets, uint32_t probes) {
+  std::vector<LanQosResult> results(targets.size());
+  if (!LanEnabled() || targets.empty() || targets.size() > 32) return results;
+  Socket socket; socket.value = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
