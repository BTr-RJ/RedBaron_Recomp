+  LanSessionId session; std::memcpy(session.data(), id, 8);
+  std::vector<uint8_t> bytes(data_size); if (data_size) std::memcpy(bytes.data(), data, data_size);
+  const bool ready = LanQosListen(session, flags, std::move(bytes));
+  REXKRNL_DEBUG("LAN QoS listener: flags={} bytes={} ready={}", flags, data_size, ready);
+  return ready ? 0 : 10022;
+}
