+#pragma once
+#include <nvsdk_ngx.h>
+#include <nvsdk_ngx_helpers.h>
+#include <rex/filesystem.h>
+#include <rex/logging.h>
+
+namespace rex::ui::d3d12 {
+// NGX Super Resolution using the same captured depth/camera motion as FSR.
+// API flow studied in Estacado-ReXGlue; all title-specific inputs are RedBaron's.
+// NVIDIA SDK components retain their separate NVIDIA RTX SDKs license.
+class Dlss {
+ public:
+  ~Dlss() {
+    if (feature_)
+      NVSDK_NGX_D3D12_ReleaseFeature(feature_);
+    if (parameters_)
+      NVSDK_NGX_D3D12_DestroyParameters(parameters_);
+    if (device_)
+      NVSDK_NGX_D3D12_Shutdown1(device_.Get());
+  }
+  bool Run(ID3D12Device* device, ID3D12GraphicsCommandList* cmd, ID3D12Resource* color,
+           ID3D12Resource* output, ID3D12Resource* depth, ID3D12Resource* motion,
+           ID3D12Resource* reactive, float jitter_x, float jitter_y, bool reset,
+           float milliseconds) {
+    const auto in = color->GetDesc(), out = output->GetDesc();
+    if (!feature_) {
+      auto folder = rex::filesystem::GetExecutableFolder();
+      auto result = NVSDK_NGX_D3D12_Init_with_ProjectID("0cc9a072-1cc4-46ab-a942-4619cd94f89a",
+                                                        NVSDK_NGX_ENGINE_TYPE_CUSTOM,
+                                                        "RedBaron_Recomp", folder.c_str(), device);
+      if (NVSDK_NGX_FAILED(result))
+        return Error("initialize", result);
+      device_ = device;
+      NVSDK_NGX_Parameter* capabilities = nullptr;
+      result = NVSDK_NGX_D3D12_GetCapabilityParameters(&capabilities);
+      int available = 0;
+      if (NVSDK_NGX_SUCCEED(result) && capabilities) {
+        NVSDK_NGX_Parameter_GetI(capabilities, NVSDK_NGX_Parameter_SuperSampling_Available,
+                                 &available);
+        NVSDK_NGX_D3D12_DestroyParameters(capabilities);
+      }
+      if (!available)
+        return Error("GPU/driver capability", result);
+      result = NVSDK_NGX_D3D12_AllocateParameters(&parameters_);
+      if (NVSDK_NGX_FAILED(result))
+        return Error("parameters", result);
+      NVSDK_NGX_DLSS_Create_Params create{};
+      create.Feature.InWidth = unsigned(in.Width);
+      create.Feature.InHeight = in.Height;
+      create.Feature.InTargetWidth = unsigned(out.Width);
+      create.Feature.InTargetHeight = out.Height;
+      const double ratio = double(out.Height) / in.Height;
+      create.Feature.InPerfQualityValue = ratio < 1.05   ? NVSDK_NGX_PerfQuality_Value_DLAA
+                                          : ratio < 1.6  ? NVSDK_NGX_PerfQuality_Value_MaxQuality
+                                          : ratio < 1.85 ? NVSDK_NGX_PerfQuality_Value_Balanced
+                                          : ratio < 2.4
+                                              ? NVSDK_NGX_PerfQuality_Value_MaxPerf
+                                              : NVSDK_NGX_PerfQuality_Value_UltraPerformance;
+      create.InFeatureCreateFlags = NVSDK_NGX_DLSS_Feature_Flags_MVLowRes |
+                                    NVSDK_NGX_DLSS_Feature_Flags_DepthInverted |
+                                    NVSDK_NGX_DLSS_Feature_Flags_AutoExposure;
+      result = NGX_D3D12_CREATE_DLSS_EXT(cmd, 1, 1, &feature_, parameters_, &create);
+      if (NVSDK_NGX_FAILED(result) || !feature_)
+        return Error("create", result);
+      REXLOG_INFO("DLSS NGX initialized: {}x{} -> {}x{} (camera-motion preview)", in.Width,
+                  in.Height, out.Width, out.Height);
+    }
+    NVSDK_NGX_D3D12_DLSS_Eval_Params eval{};
+    eval.Feature.pInColor = color;
+    eval.Feature.pInOutput = output;
+    eval.pInDepth = depth;
+    eval.pInMotionVectors = motion;
+    eval.pInBiasCurrentColorMask = reactive;
+    eval.InJitterOffsetX = jitter_x;
+    eval.InJitterOffsetY = jitter_y;
+    eval.InMVScaleX = float(in.Width);
+    eval.InMVScaleY = float(in.Height);
+    eval.InRenderSubrectDimensions = {unsigned(in.Width), in.Height};
+    eval.InReset = reset;
+    eval.InPreExposure = eval.InExposureScale = 1.f;
+    eval.InFrameTimeDeltaInMsec = milliseconds;
+    const auto result = NGX_D3D12_EVALUATE_DLSS_EXT(cmd, feature_, parameters_, &eval);
+    if (NVSDK_NGX_FAILED(result))
+      return Error("evaluate", result);
+    if (++dispatches_ % 300 == 1)
+      REXLOG_INFO("DLSS NGX evaluated {} frames", dispatches_);
+    return true;
+  }
+
+ private:
+  static bool Error(const char* stage, NVSDK_NGX_Result result) {
+    REXLOG_ERROR("DLSS {} failed: 0x{:08X}", stage, unsigned(result));
+    return false;
+  }
+  Microsoft::WRL::ComPtr<ID3D12Device> device_;
+  NVSDK_NGX_Parameter* parameters_ = nullptr;
+  NVSDK_NGX_Handle* feature_ = nullptr;
+  uint64_t dispatches_ = 0;
+};
+}  // namespace rex::ui::d3d12
