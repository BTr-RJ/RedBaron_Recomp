+bool LanHandleLobbyInvite(uint32_t user, bool pressed) {
+  auto provider = online_provider.load();
+  if (!provider || user >= 4) return false;
+  bool open = false, consume = false;
+  {
+    auto& s = State(); std::lock_guard lock(s.mutex);
+    bool have_game = false, game_lobby = false, party_lobby = false;
+    for (const auto& [id, state] : s.game_lobbies) if (state.user == user) {
+      if (state.presence) party_lobby |= state.active;
+      else { have_game = true; game_lobby |= state.active; }
+    }
+    // The persistent hangar party survives during flight. An active gameplay
+    // session takes precedence so RT remains a weapon in the actual match.
+    const bool lobby = have_game ? game_lobby : party_lobby;
+    consume = lobby && pressed;
+    open = consume && !s.invite_trigger[user];
+    s.invite_trigger[user] = pressed;
+  }
+  // Do not hold the lobby lock while the EOS worker handles the UI request.
+  if (open && !provider->InputCaptured()) provider->ShowFriends(user);
+  return consume;
+}
