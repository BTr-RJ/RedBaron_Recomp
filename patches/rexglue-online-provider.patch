+// Optional title-owned Internet provider. Install before launching guest threads
+// and detach only after they stop. The provider must synchronize its own worker.
+class LanOnlineProvider {
+ public:
+  virtual ~LanOnlineProvider() = default;
+  virtual std::vector<LanRecord> Search(uint32_t title) = 0;
+  virtual std::vector<LanQosResult> Probe(const std::vector<LanQosTarget>& targets, uint32_t probes) = 0;
+  virtual bool Connect(uint32_t guest_address) = 0;
+  virtual bool CanHost() const = 0;
+  virtual void Leave(const LanSessionId& session) = 0;
+};
+void LanSetOnlineProvider(std::shared_ptr<LanOnlineProvider> provider);
+bool LanEnsureConnected(uint32_t guest_address);
+uint32_t LanOnlinePlayerLimit();
+void LanLeaveOnline(const LanSessionId& session);
+std::vector<LanRecord> LanLocalSnapshot();
+LanQosResult LanLocalQos(const LanSessionId& session);
 }
