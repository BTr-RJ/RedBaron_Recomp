+std::vector<LanRecord> LanLocalSnapshot() {
+  auto& s = State(); std::lock_guard lock(s.mutex);
+  std::vector<LanRecord> result;
+  for (const auto& [id, record] : s.records) {
+    auto copy = record;
+    copy.contexts = s.attributes[copy.owner].contexts;
+    copy.properties = s.attributes[copy.owner].properties;
+    result.push_back(std::move(copy));
+  }
+  return result;
+}
+LanQosResult LanLocalQos(const LanSessionId& session) {
+  auto& s = State(); std::lock_guard lock(s.mutex);
+  LanQosResult result;
+  if (auto it = s.qos.find(session); it != s.qos.end()) {
+    result.contacted = true; result.disabled = !it->second.enabled;
+    if (it->second.enabled) result.data = it->second.data;
+  }
+  return result;
+}
