diff --git a/include/rex/system/xam/native_matchmaking_policy.h b/include/rex/system/xam/native_matchmaking_policy.h
new file mode 100644
--- /dev/null
+++ b/include/rex/system/xam/native_matchmaking_policy.h
@@ -0,0 +1,18 @@
+#pragma once
+#include <cstdint>
+#include <span>
+
+namespace rex::system::xam {
+// The title's Quick Match uses multiplayer search procedure 1 without a
+// GameMode property. Context 0x800B identifies multiplayer versus challenges;
+// it is not the Dog Fight / CTF / other multiplayer ruleset selector.
+inline bool SnoopyAnyModeSearch(uint32_t title, uint32_t procedure,
+                               std::span<const uint32_t> properties) {
+  if (title != 0x584109B5 || procedure != 1) return false;
+  for (auto id : properties) if (id == 0x10000046) return false;
+  return true;
+}
+inline bool SnoopyNearSortProperty(uint32_t title, uint32_t property) {
+  return title == 0x584109B5 && property == 0x10000042;
+}
+}
