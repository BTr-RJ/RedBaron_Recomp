+        "FSR 3.1.5 {} failed; disabling temporal jitter and using spatial FSR until restart",
+        operation);
+    return false;
+  }
+  struct Constants {
+    float inverse[16], previous[16];
+    uint32_t size[2], scene[2], layout[4];
+    float jitter[4];
+  };
+  static bool Inverse(const float* matrix, float* result) {
+    for (int i = 0; i < 16; i++)
+      if (!std::isfinite(matrix[i]))
+        return false;
+    double a[4][8]{};
+    for (int r = 0; r < 4; r++)
+      for (int c = 0; c < 4; c++) {
+        a[r][c] = matrix[r * 4 + c];
+        a[r][c + 4] = r == c;
+      }
+    for (int c = 0; c < 4; c++) {
+      int pivot = c;
+      for (int r = c + 1; r < 4; r++)
+        if (std::abs(a[r][c]) > std::abs(a[pivot][c]))
+          pivot = r;
+      if (std::abs(a[pivot][c]) < 1e-10)
+        return false;
+      for (int k = 0; k < 8; k++)
+        std::swap(a[c][k], a[pivot][k]);
+      double v = a[c][c];
+      for (double& x : a[c])
+        x /= v;
+      for (int r = 0; r < 4; r++)
+        if (r != c) {
+          v = a[r][c];
+          for (int k = 0; k < 8; k++)
+            a[r][k] -= v * a[c][k];
+        }
+    }
+    for (int r = 0; r < 4; r++)
+      for (int c = 0; c < 4; c++)
