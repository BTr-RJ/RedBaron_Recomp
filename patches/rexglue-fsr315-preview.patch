+    if (!frame.width || !frame.height || !frame.pitch || !frame.edram)
+      return false;
+    const auto in = color->GetDesc(), out = output->GetDesc();
+    const uint32_t width = uint32_t(in.Width), height = in.Height;
+    if (!context_ || width != width_ || height != height_ || out.Width != out_width_ ||
+        out.Height != out_height_) {
+      if (context_) {
+        ffxDestroyContext(&context_, nullptr);
+        context_ = nullptr;
+      }
+      if (!Initialize(device, width, height, uint32_t(out.Width), out.Height))
+        return Fail(frame, "initialization");
+    }
+    if (frame.id == last_id_)
+      return true;
+    Constants constants{};
+    if (!Inverse(frame.view_projection.data(), constants.inverse))
+      return Fail(frame, "camera matrix");
+    const bool reset = !last_id_ || frame.id > last_id_ + 8 || frame.seconds - last_seconds_ > .25;
+    std::memcpy(constants.previous, reset ? frame.view_projection.data() : previous_.data(), 64);
+    constants.size[0] = width;
+    constants.size[1] = height;
+    constants.scene[0] = frame.width * frame.scale_x;
+    constants.scene[1] = frame.height * frame.scale_y;
+    constants.layout[0] = frame.pitch;
+    constants.layout[1] = frame.scale_x;
+    constants.layout[2] = frame.scale_y;
+    constants.layout[3] = frame.depth_base;
+    constants.jitter[0] = frame.jitter_x / float(frame.width);
+    constants.jitter[1] = frame.jitter_y / float(frame.height);
+    auto cpu = heap_->GetCPUDescriptorHandleForHeapStart();
+    D3D12_SHADER_RESOURCE_VIEW_DESC srv{};
+    srv.Format = DXGI_FORMAT_R32_TYPELESS;
+    srv.ViewDimension = D3D12_SRV_DIMENSION_BUFFER;
+    srv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    srv.Buffer.NumElements = UINT(frame.edram->GetDesc().Width / 4);
+    srv.Buffer.Flags = D3D12_BUFFER_SRV_FLAG_RAW;
+    device->CreateShaderResourceView(frame.edram.Get(), &srv, cpu);
+    for (auto& texture : aux_)
+      Barrier(cmd, texture.Get(), D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+              D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    ID3D12DescriptorHeap* heaps[] = {heap_.Get()};
+    cmd->SetDescriptorHeaps(1, heaps);
+    cmd->SetComputeRootSignature(root_.Get());
+    cmd->SetPipelineState(pipeline_.Get());
+    cmd->SetComputeRoot32BitConstants(0, sizeof(constants) / 4, &constants, 0);
+    cmd->SetComputeRootDescriptorTable(1, heap_->GetGPUDescriptorHandleForHeapStart());
+    cmd->Dispatch((width + 7) / 8, (height + 7) / 8, 1);
+    for (auto& texture : aux_)
+      Barrier(cmd, texture.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+              D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
