+    dispatch.enableSharpening = false;
+    dispatch.sharpness = sharpness;
+    dispatch.flags = FFX_UPSCALE_FLAG_NON_LINEAR_COLOR_SRGB;
+    const auto result = ffxDispatch(&context_, &dispatch.header);
+    if (result != FFX_API_RETURN_OK) {
+      REXLOG_ERROR("FSR 3.1.5 dispatch status: {}", result);
+      return Fail(frame, "dispatch");
+    }
+    previous_ = frame.view_projection;
+    last_id_ = frame.id;
+    last_seconds_ = frame.seconds;
+    if (++dispatches_ % 300 == 1)
+      REXLOG_INFO(
+          "FSR 3.1.5 dispatch: frame {}, {}x{} -> {}x{}, reset={}, dt={} ms (camera-motion "
+          "prototype)",
