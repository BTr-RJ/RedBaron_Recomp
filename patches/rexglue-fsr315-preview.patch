+    dispatch.header.type = FFX_API_DISPATCH_DESC_TYPE_UPSCALE;
+    dispatch.commandList = cmd;
+    dispatch.color = ffxApiGetResourceDX12(color, FFX_API_RESOURCE_STATE_PIXEL_READ);
+    dispatch.depth = ffxApiGetResourceDX12(aux_[0].Get(), FFX_API_RESOURCE_STATE_COMPUTE_READ,
+                                           FFX_API_RESOURCE_USAGE_DEPTHTARGET);
+    dispatch.motionVectors =
+        ffxApiGetResourceDX12(aux_[1].Get(), FFX_API_RESOURCE_STATE_COMPUTE_READ);
+    dispatch.reactive = ffxApiGetResourceDX12(aux_[2].Get(), FFX_API_RESOURCE_STATE_COMPUTE_READ);
+    dispatch.output = ffxApiGetResourceDX12(output, FFX_API_RESOURCE_STATE_UNORDERED_ACCESS,
+                                            FFX_API_RESOURCE_USAGE_UAV);
+    dispatch.renderSize = {width, height};
+    dispatch.upscaleSize = {uint32_t(out.Width), out.Height};
+    dispatch.jitterOffset = {frame.jitter_x * float(width) / frame.width,
+                             frame.jitter_y * float(height) / frame.height};
+    dispatch.motionVectorScale = {float(width), float(height)};
+    dispatch.frameTimeDelta = reset ? 16.666f : float((frame.seconds - last_seconds_) * 1000.0);
+    dispatch.preExposure = 1;
+    dispatch.reset = reset;
+    const auto& m = frame.view_projection;
+    // The title projects forward depth, then the viewport reverses it. Recover
+    // the physical near plane from VP and use AMD's inverted/infinite convention.
+    const float a = (m[8] * m[12] + m[9] * m[13] + m[10] * m[14]) /
+                    (m[12] * m[12] + m[13] * m[13] + m[14] * m[14]);
+    dispatch.cameraNear = std::numeric_limits<float>::max();
